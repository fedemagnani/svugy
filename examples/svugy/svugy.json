      "steps": [
        {
          "description": "[The CLI](#cli) hands your text to [svugy-parse](#import), which reads Markdown, d2 or JSON into [svugy-model](#model); the d2 importer follows [the d2 grammar](#d2->import[0]). [Validate](#model.validate) checks the model before anything is drawn.",
          "id": "model",
          "items": [
            {
              "edge": {
                "from": "text",
                "ordinal": 0,
                "to": "cli"
              }
            },
            {
              "edge": {
                "from": "cli",
                "ordinal": 0,
                "to": "import"
              }
            },
            {
              "element": "import.markdown"
            },
            {
              "element": "import.d2"
            },
            {
              "element": "import.json"
            },
            {
              "edge": {
                "from": "d2",
                "ordinal": 0,
                "to": "import"
              }
            },
            {
              "edge": {
                "from": "import",
                "ordinal": 0,
                "to": "model"
              }
            },
            {
              "edge": {
                "from": "model.path",
                "ordinal": 0,
                "to": "model.graph"
              }
            },
            {
              "edge": {
                "from": "model.graph",
                "ordinal": 0,
                "to": "model.validate"
              }
            }
          ],
          "title": "① Your text becomes a model"
        },
        {
          "description": "[The pipeline](#pipeline) measures every label with [Inter](#pipeline.inter), the bundled font. Then [place](#pipeline.layout.place) puts the boxes, [route](#pipeline.layout.route) anchors each edge on a port and [stub](#pipeline.layout.stub) picks where edges leave their container.",
          "id": "layout",
          "items": [
            {
              "edge": {
                "from": "cli",
                "ordinal": 0,
                "to": "pipeline"
              }
            },
            {
              "edge": {
                "from": "model",
                "ordinal": 0,
                "to": "pipeline"
              }
            },
            {
              "edge": {
                "from": "pipeline.metrics",
                "ordinal": 0,
                "to": "pipeline.layout"
              }
            },
            {
              "edge": {
                "from": "pipeline.metrics",
                "ordinal": 0,
                "to": "pipeline.inter"
              }
            },
            {
              "edge": {
                "from": "pipeline.layout.place",
                "ordinal": 0,
                "to": "pipeline.layout.route"
              }
            },
            {
              "edge": {
                "from": "pipeline.layout.route",
                "ordinal": 0,
                "to": "pipeline.layout.stub"
              }
            }
          ],
          "title": "② The model becomes boxes in plan space"
        },
        {
          "description": "[The geometry](#pipeline.geometry) turns each box into an isometric solid and orders the solids for painting; [the renderer](#pipeline.render) themes them and writes [one SVG file](#pipeline->svg[0]).",
          "id": "render",
          "items": [
            {
              "edge": {
                "from": "pipeline.layout",
                "ordinal": 0,
                "to": "pipeline.geometry"
              }
            },
            {
              "edge": {
                "from": "pipeline.geometry",
                "ordinal": 0,
                "to": "pipeline.render"
              }
            },
            {
              "edge": {
                "from": "pipeline.geometry.projection",
                "ordinal": 0,
                "to": "pipeline.geometry.primitive"
              }
            },
            {
              "edge": {
                "from": "pipeline.geometry.primitive",
                "ordinal": 0,
                "to": "pipeline.geometry.depth"
              }
            },
            {
              "edge": {
                "from": "pipeline.render.theme",
                "ordinal": 0,
                "to": "pipeline.render.profile"
              }
            },
            {
              "edge": {
                "from": "pipeline.render.profile",
                "ordinal": 0,
                "to": "pipeline.render.writer"
              }
            },
            {
              "edge": {
                "from": "pipeline.render.profile",
                "ordinal": 0,
                "to": "pipeline.inter"
              }
            },
            {
              "edge": {
                "from": "pipeline",
                "ordinal": 0,
                "to": "svg"
              }
            }
          ],
          "title": "③ Boxes become shapes, ④ shapes one SVG file"
        },
        {
          "description": "[The writer](#pipeline.render.writer) emits the `data-svugy-*` attributes of [the runtime contract](#contract). [The runtime](#runtime), embedded at build time, reads them inside [the SVG](#svg) to make it explorable.",
          "id": "runtime",
          "items": [
            {
              "edge": {
                "from": "pipeline.render.writer",
                "ordinal": 0,
                "to": "contract"
              }
            },
            {
              "edge": {
                "from": "runtime",
                "ordinal": 0,
                "to": "contract"
              }
            },
            {
              "edge": {
                "from": "runtime",
                "ordinal": 0,
                "to": "svg"
              }
            }
          ],
          "title": "The runtime ships inside the file"
        }
      ],
      "subtitle": "text in → model → layout → geometry → SVG out",
      "title": "svugy · how it is built"
    }
  ]
