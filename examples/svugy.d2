# d2 v0.9.0 · the golden: svugy drawn by svugy, the twin of crates/svugy/tests/golden/svugy.rs, importing into examples/svugy.json
# svugy reads what d2 cannot say from `vars: { svugy: { … } }`; d2 compiles and ignores it.

label: "svugy · how it is built"
vars: {
  svugy: {
    subtitle: "text in → model → layout → geometry → SVG out"
    legend: {
      title: Read it as a story
      entries: [
        "① your text becomes a model"
        "② the model becomes boxes in plan space"
        "③ boxes become isometric shapes"
        "④ shapes become one SVG file, runtime inside"
      ]
      dashes: { 5: data flows this way; 2: embedded at build time }
      badges: { pipeline.inter: reads the bundled font }
    }
  }
}

text: your text {
  style.fill: "#3a3f4b"
  vars: { svugy: { caption: "d2 · JSON · Rust builder"; position: { x: 0; y: 40 } } }
}

cli: svugy-cli {
  style.fill: "#9945ff"
  link: pipeline
  vars: { svugy: { caption: "render · validate · import"; height: 70; position: { x: 0; y: 330 } } }
}

d2: d2 v0.9.0 {
  style: { fill: transparent; stroke: "#5b6170"; stroke-dash: 5 }
  link: "https://d2lang.com"
  vars: { svugy: { caption: "reference grammar"; position: { x: 260; y: -220 } } }
}

import: svugy-import {
  style.fill: "#2a2418"
  vars: { svugy: { caption: "d2 → model"; position: { x: 260; y: 0 } } }

  lex: {
    style.fill: "#f0a020"
    vars: { svugy: { caption: "logos tokens"; position: { x: 18; y: 18 } } }
  }
  parse: {
    style.fill: "#f0a020"
    vars: { svugy: { caption: "chumsky + recovery"; position: { x: 150; y: 18 } } }
  }
  lower: {
    style.fill: "#f0a020"
    vars: { svugy: { caption: "AST → model"; position: { x: 282; y: 18 } } }
  }
  lex -> parse
  parse -> lower
}

model: svugy-model {
  style.fill: "#17271f"
  vars: { svugy: { caption: "the hub"; position: { x: 260; y: 330 } } }

  path: {
    style.fill: "#14f195"
    vars: { svugy: { caption: "ids"; position: { x: 18; y: 18 } } }
  }
  graph: model {
    style.fill: "#14f195"
    vars: { svugy: { caption: "elements · edges"; position: { x: 150; y: 18 } } }
  }
  validate: {
    style.fill: "#14f195"
    vars: { svugy: { caption: "problems · bounds"; position: { x: 18; y: 180 } } }
  }
  json: {
    style.fill: "#14f195"
    vars: { svugy: { caption: "id-keyed schema"; position: { x: 150; y: 180 } } }
  }
  path -> graph
  graph -> validate
  graph -> json
}

pipeline: svugy {
  style.fill: "#1b2436"
  vars: { svugy: { caption: "the pipeline"; position: { x: 760; y: 0 } } }

  metrics: {
    style.fill: "#3478f6"
    vars: { svugy: { caption: "measures labels"; position: { x: 600; y: 36 } } }
  }
  inter: Inter {
    shape: cylinder
    style.fill: "#d5dcea"
    vars: { svugy: { badge: true; position: { x: 780; y: 54 } } }
  }
  layout: {
    style.fill: "#1f3566"
    vars: { svugy: { caption: "plan space"; position: { x: 36; y: 36 } } }

    place: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "dagre · taffy · pins"; position: { x: 18; y: 18 } } }
    }
    route: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "ports"; position: { x: 150; y: 18 } } }
    }
    stub: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "boundary slots"; position: { x: 282; y: 18 } } }
    }
    place -> route
    route -> stub
  }
  geometry: {
    style.fill: "#1f3566"
    vars: { svugy: { caption: "screen space"; position: { x: 36; y: 300 } } }

    projection: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "exact constants"; position: { x: 18; y: 18 } } }
    }
    primitive: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "4 primitives"; position: { x: 150; y: 18 } } }
    }
    depth: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "painter's order"; position: { x: 282; y: 18 } } }
    }
    projection -> primitive
    primitive -> depth
  }
  render: {
    style.fill: "#1f3566"
    vars: { svugy: { caption: "markup"; position: { x: 560; y: 300 } } }

    theme: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "tokens · Oklab"; position: { x: 18; y: 18 } } }
    }
    profile: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "static · interactive"; position: { x: 150; y: 18 } } }
    }
    writer: {
      style.fill: "#3478f6"
      vars: { svugy: { caption: "escaping · decimals"; position: { x: 282; y: 18 } } }
    }
    theme -> profile
    profile -> writer
  }
  metrics -> layout
  layout -> geometry: ③
  geometry -> render
  metrics -> inter: measures
  render.profile -> inter: outlines
}

contract: runtime contract {
  style.fill: "#334566"
  vars: { svugy: { caption: "data-svugy-*"; shape: slab; position: { x: 1560; y: 760 } } }
}

runtime: {
  style.fill: "#3a3f4b"
  vars: { svugy: { caption: "svugy.js · svugy.css"; position: { x: 1900; y: 620 } } }
}

svg: one .svg file {
  style.fill: "#d5dcea"
  shape: circle
  vars: { svugy: { position: { x: 1900; y: 330 } } }
}

text -> cli
cli -> import
cli -> pipeline
import -> model: ①
model -> pipeline: ②
pipeline -> svg: ④
runtime -> svg: { style.stroke-dash: 2 }
d2 -> import: grammar { style: { stroke: "#5b6170"; stroke-dash: 5 } }
pipeline.render.writer -> contract: emits { style.stroke-dash: 2 }
runtime -> contract: reads { style.stroke-dash: 2 }
