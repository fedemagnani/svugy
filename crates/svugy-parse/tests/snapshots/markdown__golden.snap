      "steps": [
        {
          "id": "model",
          "title": "① Your text becomes a model",
          "description": "[The CLI](#cli) hands your text to [svugy-parse](#import), which reads Markdown, d2 or JSON into [svugy-model](#model); the d2 importer follows [the d2 grammar](#d2->import[0]). [Validate](#model.validate) checks the model before anything is drawn.",
          "items": [
            {
              "edge": {
                "from": "text",
                "to": "cli",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "cli",
                "to": "import",
                "ordinal": 0
              }
            },
            {
              "element": "import.markdown"
            },
            {
              "element": "import.d2"
            },
            {
              "element": "import.json"
            },
            {
              "edge": {
                "from": "d2",
                "to": "import",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "import",
                "to": "model",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "model.path",
                "to": "model.graph",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "model.graph",
                "to": "model.validate",
                "ordinal": 0
              }
            }
          ],
          "span": {
            "start": 2639,
            "end": 2644
          }
        },
        {
          "id": "layout",
          "title": "② The model becomes boxes in plan space",
          "description": "[The pipeline](#pipeline) measures every label with [Inter](#pipeline.inter), the bundled font. Then [place](#pipeline.layout.place) puts the boxes, [route](#pipeline.layout.route) anchors each edge on a port and [stub](#pipeline.layout.stub) picks where edges leave their container.",
          "items": [
            {
              "edge": {
                "from": "cli",
                "to": "pipeline",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "model",
                "to": "pipeline",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.metrics",
                "to": "pipeline.layout",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.metrics",
                "to": "pipeline.inter",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.layout.place",
                "to": "pipeline.layout.route",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.layout.route",
                "to": "pipeline.layout.stub",
                "ordinal": 0
              }
            }
          ],
          "span": {
            "start": 3080,
            "end": 3086
          }
        },
        {
          "id": "render",
          "title": "③ Boxes become shapes, ④ shapes one SVG file",
          "description": "[The geometry](#pipeline.geometry) turns each box into an isometric solid and orders the solids for painting; [the renderer](#pipeline.render) themes them and writes [one SVG file](#pipeline->svg[0]).",
          "items": [
            {
              "edge": {
                "from": "pipeline.layout",
                "to": "pipeline.geometry",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.geometry",
                "to": "pipeline.render",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline.geometry.projection",
                "to": "pipeline.geometry.primitive",
                "ordinal": 0
              }
            },
            {
