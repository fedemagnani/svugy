                "to": "pipeline.inter",
                "ordinal": 0
              }
            },
            {
              "edge": {
                "from": "pipeline",
                "to": "svg",
                "ordinal": 0
              }
            }
          ],
          "span": {
            "start": 3493,
            "end": 3499
          }
        },
        {
          "id": "runtime",
          "title": "The runtime ships inside the file",
