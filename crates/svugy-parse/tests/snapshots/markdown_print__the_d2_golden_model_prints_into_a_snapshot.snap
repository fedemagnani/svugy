#### main: Every edge
- path -> graph
- graph -> validate
- place -> route
- route -> stub
- projection -> primitive
- primitive -> depth
- theme -> profile
- profile -> writer
- metrics -> layout
- layout -> geometry: ③
- geometry -> render
- metrics -> inter: measures (line=badge)
- profile -> inter: outlines (line=badge)
- text -> cli
- cli -> import
- cli -> pipeline
- import -> model: ①
- model -> pipeline: ②
- pipeline -> svg: ④
- runtime -> svg (line=dotted)
