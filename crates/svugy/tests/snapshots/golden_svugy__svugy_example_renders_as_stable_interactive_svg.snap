<svg data-svugy-contract="1" height="1451.998" viewBox="-557.472 40.257 1936.438 1451.998" width="1936.438" xmlns="http://www.w3.org/2000/svg">
<style>/*<![CDATA[*/[data-svugy-contract]{--svugy-canvas:#0a0b10;--svugy-grid-line:#151722;--svugy-face-outline:#0a0b10;--svugy-text:#e6e8ee;--svugy-text-muted:#8b93a5;--svugy-external-outline:#5b6170;--svugy-neutral-top:#3a3f4b;--svugy-neutral-left:#2b2f39;--svugy-neutral-right:#22252d;--svugy-neutral-ink:#e6e8ee;--svugy-container-blue-top:#1b2436;--svugy-container-blue-left:#131a28;--svugy-container-blue-right:#0d131f;--svugy-container-blue-ink:#8aa0c8;font-family:Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif}
@media (prefers-color-scheme: light){
[data-svugy-contract]{--svugy-canvas:#f6f8ff;--svugy-grid-line:#e1e4f4;--svugy-face-outline:#f6f8ff;--svugy-text:#14161a;--svugy-text-muted:#535a6a;--svugy-external-outline:#858b9b;--svugy-neutral-top:#acb2c0;--svugy-neutral-left:#868b96;--svugy-neutral-right:#6d717b;--svugy-neutral-ink:#14161a;--svugy-container-blue-top:#c8d4ed;--svugy-container-blue-left:#9da6ba;--svugy-container-blue-right:#808898;--svugy-container-blue-ink:#3c4f72}
}
[data-svugy-overlay] { visibility: hidden; }
[data-svugy-entered] > [data-svugy-overlay] { visibility: visible; }

[data-svugy-flow] { animation: svugy-flow 1.2s linear infinite; }
@keyframes svugy-flow { to { stroke-dashoffset: -24; } }

[data-svugy-contract]:focus,
[data-svugy-contract] [tabindex]:focus { outline: none; }
:is([data-svugy-element], [data-svugy-stub])[role="button"] { cursor: pointer; }
:is([data-svugy-element], [data-svugy-stub])[role="button"]:has([data-svugy-entered]) { cursor: auto; }
:is([data-svugy-element], [data-svugy-stub])[role="button"]:hover:not(:has([role="button"]:hover, [data-svugy-entered])) > :is(path, rect),
:is([data-svugy-element], [data-svugy-edge], [data-svugy-stub]):focus-visible:not(:has([data-svugy-entered])) > :is(path, rect) { stroke: var(--svugy-text); stroke-opacity: 1; stroke-width: 2; fill-opacity: 0.8; }

[data-svugy-contract] .svugy-panel { pointer-events: none; }
[data-svugy-contract] .svugy-panel-plate { fill: #12141c; fill-opacity: 0.96; stroke: #2c3242; stroke-width: 1; }
[data-svugy-contract] .svugy-panel-title,
[data-svugy-contract] .svugy-panel-body { font-family: Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; text-anchor: start; letter-spacing: 0; }
[data-svugy-contract] .svugy-panel-title { font-size: 12.5px; font-weight: 650; fill: #eef0f6; }
[data-svugy-contract] .svugy-panel-body { font-size: 11.5px; font-weight: 450; fill: #a6adbf; }

@media (prefers-color-scheme: light) {
  [data-svugy-contract] .svugy-panel-plate { fill: #ffffff; stroke: #d5d9e3; }
  [data-svugy-contract] .svugy-panel-title { fill: #161922; }
  [data-svugy-contract] .svugy-panel-body { fill: #545b6c; }
}

@media (prefers-reduced-motion: reduce) {
  [data-svugy-flow] { animation: none; }
  [data-svugy-dot] { visibility: hidden; }
}
/*]]>*/</style>
