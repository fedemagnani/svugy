<g data-svugy-heading="">
<text fill="var(--svugy-text)" font-size="17" font-weight="700" text-anchor="start" textLength="174.242" x="18" y="-26.774">svugy · how it is built</text>
<text fill="var(--svugy-text-muted)" font-size="11.5" font-weight="400" text-anchor="start" textLength="266.319" x="18" y="-8.774">text in → model → layout → geometry → SVG out</text>
