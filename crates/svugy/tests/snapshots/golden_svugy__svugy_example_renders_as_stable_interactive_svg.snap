<svg data-svugy-contract="3" height="1455.521" viewBox="-557.472 36.734 1936.438 1455.521" width="1936.438" xmlns="http://www.w3.org/2000/svg">
<style>/*<![CDATA[*/[data-svugy-contract]{--svugy-canvas:#0a0b10;--svugy-grid-line:#151722;--svugy-face-outline:#0a0b10;--svugy-text:#e6e8ee;--svugy-text-muted:#8b93a5;--svugy-external-outline:#5b6170;--svugy-neutral-top:#3a3f4b;--svugy-neutral-left:#2b2f39;--svugy-neutral-right:#22252d;--svugy-neutral-ink:#e6e8ee;--svugy-container-blue-top:#1b2436;--svugy-container-blue-left:#131a28;--svugy-container-blue-right:#0d131f;--svugy-container-blue-ink:#8aa0c8;font-family:Inter, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif}
@media (prefers-color-scheme: light){
[data-svugy-contract]{--svugy-canvas:#f6f8ff;--svugy-grid-line:#e1e4f4;--svugy-face-outline:#f6f8ff;--svugy-text:#14161a;--svugy-text-muted:#535a6a;--svugy-external-outline:#858b9b;--svugy-neutral-top:#acb2c0;--svugy-neutral-left:#868b96;--svugy-neutral-right:#6d717b;--svugy-neutral-ink:#14161a;--svugy-container-blue-top:#c8d4ed;--svugy-container-blue-left:#9da6ba;--svugy-container-blue-right:#808898;--svugy-container-blue-ink:#3c4f72}
}
[data-svugy-camera]:not([data-svugy-shown]),
[data-svugy-layer]:not([data-svugy-shown]) { visibility: hidden; }
[data-svugy-overlay] { visibility: hidden; }
[data-svugy-shown] [data-svugy-entered] > [data-svugy-overlay] { visibility: visible; }

[data-svugy-flow] { animation: svugy-flow 1.2s linear infinite; }
[data-svugy-hachure] { pointer-events: none; }
@keyframes svugy-flow { to { stroke-dashoffset: -24; } }

[data-svugy-dimmed] > :not([data-svugy-level], [data-svugy-edge]) { opacity: 0.2; }

[data-svugy-contract]:focus,
[data-svugy-contract] [tabindex]:focus { outline: none; }
:is([data-svugy-element], [data-svugy-edge], [data-svugy-stub], [data-svugy-heading])[role="button"] { cursor: pointer; }
[data-svugy-contract] [data-svugy-heading]:focus-visible { outline: 1px dashed var(--svugy-text-muted); outline-offset: 4px; }
:is([data-svugy-element], [data-svugy-stub])[role="button"]:has([data-svugy-entered]) { cursor: grab; }
[data-svugy-contract] { background: var(--svugy-canvas); cursor: grab; touch-action: pan-x pan-y; -webkit-user-select: none; user-select: none; }
[data-svugy-contract] .svugy-description { -webkit-user-select: text; user-select: text; }
[data-svugy-contract][data-svugy-panning], [data-svugy-contract][data-svugy-panning] * { cursor: grabbing; }
[data-svugy-contract][data-svugy-panning] .svugy-panel { visibility: hidden; }
:is([data-svugy-element], [data-svugy-stub])[role="button"]:hover:not(:has([role="button"]:hover, [data-svugy-entered])) > :is(path, rect):not([data-svugy-hachure], [data-svugy-face-fill]),
:is([data-svugy-element], [data-svugy-edge], [data-svugy-stub]):focus-visible:not(:has([data-svugy-entered])) > :is(path, rect):not([data-svugy-hachure], [data-svugy-face-fill]) { stroke: var(--svugy-text); stroke-opacity: 1; stroke-width: 2; fill-opacity: 0.8; }
[data-svugy-contract] .svugy-highlighted { animation: svugy-highlight 0.3s ease-in-out 4 alternate; }
[data-svugy-contract] .svugy-highlighted > :is(path, rect):not([data-svugy-hachure], [data-svugy-face-fill]) { stroke: var(--svugy-container-blue-ink); stroke-opacity: 1; stroke-width: 2.5; }
@keyframes svugy-highlight { to { filter: drop-shadow(0 0 6px var(--svugy-container-blue-ink)); } }

[data-svugy-contract] .svugy-panel { pointer-events: none; }
[data-svugy-contract] .svugy-panel-plate { fill: color-mix(in srgb, var(--svugy-canvas) 96%, white); fill-opacity: 0.96; stroke: color-mix(in srgb, var(--svugy-text-muted) 25%, var(--svugy-canvas)); stroke-width: 1; }
[data-svugy-contract] :is(.svugy-panel-title, .svugy-panel-body) { text-anchor: start; letter-spacing: 0; }
[data-svugy-contract] .svugy-panel-title { font-size: 12.5px; font-weight: 650; fill: var(--svugy-text); }
[data-svugy-contract] .svugy-panel-body { font-size: 11.5px; font-weight: 450; fill: var(--svugy-text-muted); }

[data-svugy-contract] .svugy-cameras-frame { overflow: visible; }
[data-svugy-contract] .svugy-cameras { box-sizing: border-box; display: inline-flex; gap: 2px; padding: 3px; border: 1px solid color-mix(in srgb, var(--svugy-text-muted) 40%, transparent); border-radius: 8px; background: color-mix(in srgb, var(--svugy-canvas) 94%, var(--svugy-text)); box-shadow: 0 4px 16px rgb(0 0 0 / 0.25); font-size: 11px; font-weight: 600; line-height: 1; }
[data-svugy-contract] .svugy-cameras button { margin: 0; padding: 6px 10px; border: 0; border-radius: 6px; background: none; color: var(--svugy-text-muted); font: inherit; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; }
[data-svugy-contract] .svugy-cameras button:hover { color: var(--svugy-text); }
[data-svugy-contract] .svugy-cameras button[aria-pressed="true"] { background: color-mix(in srgb, var(--svugy-text) 14%, transparent); color: var(--svugy-text); }
[data-svugy-contract] .svugy-cameras button:focus-visible { outline: 1px dashed var(--svugy-text-muted); outline-offset: 1px; }
[data-svugy-contract] .svugy-description-frame { overflow: visible; }
[data-svugy-contract] .svugy-description { box-sizing: border-box; max-height: 100%; overflow-y: auto; padding: 12px 14px; border: 1px solid color-mix(in srgb, var(--svugy-text-muted) 40%, transparent); border-radius: 8px; background: color-mix(in srgb, var(--svugy-canvas) 94%, var(--svugy-text)); box-shadow: 0 4px 16px rgb(0 0 0 / 0.25); color: var(--svugy-text); font-size: 12.5px; font-weight: 450; line-height: 1.5; overflow-wrap: anywhere; }
[data-svugy-contract] .svugy-description :is(h3, h4, h5, h6, p, ul, ol, pre, section) { margin: 0 0 8px; }
[data-svugy-contract] .svugy-description > :last-child,
[data-svugy-contract] .svugy-description :is(section, li) > :last-child { margin-bottom: 0; }
[data-svugy-contract] .svugy-description :is(ul, ol) { padding-left: 18px; }
[data-svugy-contract] .svugy-description li > :is(ul, ol) { margin-top: 2px; }
[data-svugy-contract] .svugy-description :is(h4, h5, h6) { margin-top: 12px; font-weight: 650; line-height: 1.3; }
[data-svugy-contract] .svugy-description > :first-child:is(h4, h5, h6) { margin-top: 0; }
[data-svugy-contract] .svugy-description h4 { font-size: 13.5px; }
[data-svugy-contract] .svugy-description h5 { font-size: 12.5px; }
[data-svugy-contract] .svugy-description h6 { font-size: 11.5px; color: var(--svugy-text-muted); }
[data-svugy-contract] .svugy-description section + section { padding-top: 8px; border-top: 1px solid color-mix(in srgb, var(--svugy-text-muted) 25%, transparent); }
[data-svugy-contract] .svugy-description .svugy-description-source-edge { margin-bottom: 4px; font-size: 11.5px; font-weight: 650; color: var(--svugy-text-muted); }
[data-svugy-contract] .svugy-description pre { padding: 6px 8px; border-radius: 6px; background: color-mix(in srgb, var(--svugy-text) 8%, transparent); overflow-x: auto; white-space: pre; overflow-wrap: normal; }
[data-svugy-contract] .svugy-description pre code { padding: 0; background: none; }
[data-svugy-contract] .svugy-description code { padding: 1px 4px; border-radius: 4px; background: color-mix(in srgb, var(--svugy-text) 12%, transparent); font: 11.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
[data-svugy-contract] .svugy-description a { color: var(--svugy-container-blue-ink); }
[data-svugy-contract] .svugy-description button { margin: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; line-height: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); text-underline-offset: 2px; cursor: pointer; }
[data-svugy-contract] .svugy-description button:hover, [data-svugy-contract] .svugy-description button:focus-visible { color: var(--svugy-link-hover, var(--svugy-container-blue-ink)); text-decoration-color: currentColor; outline: none; }

@media (prefers-reduced-motion: reduce) {
  [data-svugy-flow] { animation: none; }
  [data-svugy-traveler] { visibility: hidden; }
  [data-svugy-contract] .svugy-highlighted { animation: none; }
}
/*]]>*/</style>
